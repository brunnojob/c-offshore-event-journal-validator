{
  "repository": "brunnojob/c-offshore-event-journal-validator",
  "inputs": [
    ".proof/scenarios.json",
    "examples/input.txt"
  ],
  "cases": [
    {
      "name": "make test && ./app < examples/input.txt",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "make test && ./app < examples/input.txt"
      ],
      "timeout": 900,
      "display": false
    },
    {
      "name": "Application demonstration with checked output",
      "argv": [
        "./app"
      ],
      "input": "examples/input.txt",
      "contains": [
        "missing=1",
        "records=3 gap_events=1"
      ]
    },
    {
      "name": "Reject an empty capture",
      "argv": [
        "./app"
      ],
      "stdin": "",
      "exit": 2
    },
    {
      "name": "Reject malformed input",
      "argv": [
        "./app"
      ],
      "stdin": "broken,input\n",
      "exit": 2
    },
    {
      "name": "Reject unsupported invocation",
      "argv": [
        "./app",
        "--unsupported"
      ],
      "exit": 2,
      "contains": [
        "arguments"
      ]
    },
    {
      "name": "Reject an oversized input record",
      "argv": [
        "./app"
      ],
      "stdin": "\n",
      "exit": 2,
      "contains": [
        "record too large"
      ]
    }
  ]
}
